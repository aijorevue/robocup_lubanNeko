<?xml version="1.0"?>
<robot name="simple_3dof_pitch_arm">

  <!-- 0. ?????? (???????? -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>

  <!-- 1. ????????? (Pan) -->
  <joint name="joint_pan" type="revolute">
    <parent link="base_link"/>
    <child link="link_yaw"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <!-- ????-->
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <!-- ??????????????????????????????????? -->
  <link name="link_yaw">
    <visual>
      <geometry><cylinder length="0.02" radius="0.08"/></geometry>
      <material name="black"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
  </link>

  <!-- 2. ????????? (Pitch 1) -->
  <joint name="joint_pitch_1" type="revolute">
    <parent link="link_yaw"/>
    <child link="link_blue"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- ???????-->
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <!-- ?????-->
  <link name="link_blue">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>

  <!-- 3. ????????? (Pitch 2) -->
  <joint name="joint_pitch_2" type="revolute">
    <parent link="link_blue"/>
    <child link="link_green"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- ???????-->
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <!-- ?????-->
  <link name="link_green">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.2"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
  </link>

  <!-- 4. ????????? (Pitch 3) -->
  <joint name="joint_pitch_3" type="revolute">
    <parent link="link_green"/>
    <child link="link_red"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <!-- ???????-->
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <!-- ?????(???) -->
  <link name="link_red">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.1"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
  </link>

  <!-- 5. ??????????????????????????-->
  <joint name="joint_gripper_servo" type="revolute">
    <parent link="link_red"/>
    <child link="link_gripper_servo"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-1" upper="1" velocity="1.5"/>
  </joint>

  <link name="link_gripper_servo">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.06"/></geometry>
      <material name="dark_gray"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
  </link>

  <!-- ????????-->
  <joint name="joint_gripper_left" type="revolute">
    <parent link="link_gripper_servo"/>
    <child link="link_gripper_left"/>
    <origin xyz="0.025 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="0.0" upper="1.0" velocity="1.5"/>
  </joint>

  <link name="link_gripper_left">
    <visual>
      <origin xyz="0.015 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.03 0.01 0.08"/></geometry>
      <material name="silver"><color rgba="0.85 0.85 0.85 1"/></material>
    </visual>
  </link>

  <!-- ???????????? mimic ????????????????-->
  <joint name="joint_gripper_right" type="revolute">
    <parent link="link_gripper_servo"/>
    <child link="link_gripper_right"/>
    <origin xyz="-0.025 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="1000.0" lower="0.0" upper="1.0" velocity="1.5"/>
    <mimic joint="joint_gripper_left" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="link_gripper_right">
    <visual>
      <origin xyz="-0.015 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.03 0.01 0.08"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

</robot>
